# Google Gemini API Key (aus Google AI Studio)
GEMINI_API_KEY="your_gemini_api_key_here"


BACKEND_URL="http://localhost:4000"

# Name der Agent-Wallet (backend/.agent-wallets/<name>.json, wird beim ersten Start angelegt).
# Adresse zum Aufladen: cd ../backend && bun agent/cli.ts --wallet buyer address
AGENT_WALLET=buyer

# Optional: bestehender BSV Key des Agenten (Hex – verlässt niemals die lokale Maschine!)
# AGENT_PRIVATE_KEY="dein_64_stelliger_hex_private_key"

# Agent Konfiguration
AGENT_BUDGET_SATS=10000
ESTIMATED_FEE_SATS=150
USE_MOCK_LLM=False