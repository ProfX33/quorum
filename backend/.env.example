PORT=4000
# Frontend dev server origin allowed by CORS
CORS_ORIGIN=http://localhost:3000
# Start with `docker compose up -d` in the repo root
DATABASE_URL=postgres://app:app@localhost:5432/app

# Payments: BSV network ("main" or "test") and the Arcade broadcaster used to submit and track them
BSV_NETWORK=main
ARCADE_URL=https://arcade-v2-us-1.bsvblockchain.tech
# Minutes winners have to pay after an offer settles
PAYMENT_WINDOW_MINUTES=60
# Largest encrypted data file sellers can upload
MAX_DATA_MB=20
